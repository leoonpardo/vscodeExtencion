{
  "name": "ipardo",
  "displayName": "iPardo",
  "description": "desarrollado por manuel estudiante del instituto pardo simulanodo el comportamiento de modos estilo VIM",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
    "contributes": {
  "commands": [
    {
      "command": "myModal.toggle",
      "title": "Mover hacia abajo"
    },    {
      "command": "myModal.eCommand",
      "title": "Mover hacia abajo"
        },    {
      "command": "myModal.rCommand",
      "title": "Mover hacia abajo"
    }

  ]

,
  "keybindings": [
    {
      "key": ";",
      "command": "myModal.toggle",
      "when": "editorTextFocus"
    },    {
      "key": "space",
      "command": "myModal.spaceCommand",
      "when": "editorTextFocus"
    },    {

      "key": "e",
      "command": "myModal.eCommand",
      "when": "editorTextFocus"
    }

  ]
}
 ,
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
